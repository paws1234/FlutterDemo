{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // Demo-only: "*" lets any origin reach the hub, which is what the local emulator and
    // Chrome need. Tighten to the real client origins (plan §11) before anything non-local.
    "AllowedOrigins": [ "*" ]
  }
}
